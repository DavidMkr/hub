---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site } from "../content/site"
---

<BaseLayout title={site.brand} description={site.description}>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
    <p class="text-sm font-medium tracking-wide text-muted uppercase">
      {site.name} · {site.location}
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">
      {site.role}
    </h1>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-wash px-3 py-1 text-sm text-muted">
      <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
      Now — {site.now}
    </p>
    <p class="mt-8 max-w-2xl text-lg text-muted">
      {site.description}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a class="pressable btn-solid" href="/resume" data-pressable>Resume</a>
      <a class="pressable btn-ghost" href={site.github} data-pressable>GitHub</a>
      <a class="pressable btn-ghost" href={site.linkedin} data-pressable>LinkedIn</a>
    </div>
  </section>
</BaseLayout>
